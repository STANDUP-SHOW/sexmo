DATABASE_URL="postgresql://postgres:postgres@localhost:5434/libertine?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4100
CORS_ORIGIN="http://localhost:3100"
UPLOAD_DIR="./uploads"
MIN_AGE=18
# Optionnel : sans cette clé, l'assistant IA de conversation répond 503
# ("indisponible") mais le reste du site fonctionne normalement.
ANTHROPIC_API_KEY=

# Stockage des photos/vidéos des membres : "local" (disque du serveur,
# par défaut) ou "ftp" (serveur FTP externe, ex. OVH — voir les variables
# FTP_* ci-dessous). Passer à "ftp" quand les limites de l'hébergement sont
# connues ; aucun changement de code nécessaire, juste ces variables.
STORAGE_DRIVER=local
# FTP_HOST=
# FTP_PORT=21
# FTP_USER=
# FTP_PASSWORD=
# FTP_REMOTE_DIR=/uploads
# FTP_SECURE=false
